<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!--
          Integrated Security=True : 윈도우 로그인 계정으로 SQL Server 에 접속 (비밀번호를 파일에 적지 않아도 됨)
          SQL 인증을 쓰려면:  Server=localhost;Database=TempMonitorDB;User ID=아이디;Password=비번;TrustServerCertificate=True
        -->
        <add name="TempMonitorDB"
             connectionString="Server=localhost;Database=TempMonitorDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
